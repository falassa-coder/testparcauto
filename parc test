<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Test Firestore — Parc Auto Mali</title>
</head>
<body>
  <h1>Test de connexion Firestore</h1>
  <button id="btnEcrire">Ajouter un véhicule test</button>
  <button id="btnLire">Lire les véhicules</button>
  <pre id="resultat">Résultat ici...</pre>

  <!-- ============================================================
       SDK Firebase (via CDN — pas besoin d'installer quoi que ce soit,
       comme pour Civicum où tout était dans un seul fichier).
  ============================================================ -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import {
      getFirestore,
      collection,
      addDoc,
      getDocs,
    } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    // ============================================================
    // 🔧 À REMPLACER : copie ces valeurs depuis la console Firebase
    // (Paramètres du projet ⚙️ → Général → tes applications → SDK config)
    // ============================================================
    const firebaseConfig = {
      apiKey: "TA_CLE_API",
      authDomain: "TON_PROJET.firebaseapp.com",
      projectId: "TON_PROJET",
      storageBucket: "TON_PROJET.appspot.com",
      messagingSenderId: "TON_ID",
      appId: "TON_APP_ID",
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);
    const resultat = document.getElementById("resultat");

    // ---- ÉCRIRE un véhicule test dans la collection "vehicules" ----
    document.getElementById("btnEcrire").addEventListener("click", async () => {
      try {
        const ref = await addDoc(collection(db, "vehicules"), {
          marque: "Toyota Corolla (test)",
          prix: 4500000,
          annee: 2018,
          km: 62000,
          creeLe: new Date().toISOString(),
        });
        resultat.textContent = "✅ Véhicule ajouté avec l'id : " + ref.id;
      } catch (erreur) {
        resultat.textContent = "❌ Erreur : " + erreur.message;
      }
    });

    // ---- LIRE tous les véhicules de la collection ----
    document.getElementById("btnLire").addEventListener("click", async () => {
      try {
        const snapshot = await getDocs(collection(db, "vehicules"));
        const vehicules = snapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }));
        resultat.textContent = JSON.stringify(vehicules, null, 2);
      } catch (erreur) {
        resultat.textContent = "❌ Erreur : " + erreur.message;
      }
    });
  </script>
</body>
</html>
